rules_version = '2';

// =====================================================================
// এই ফাইলটা Firebase Console > Firestore Database > Rules ট্যাবে পেস্ট
// করতে হবে (অথবা Firebase CLI দিয়ে deploy করতে হবে)। বিস্তারিত ধাপ
// README.md এ "ধাপ ৫" এ দেওয়া আছে।
//
// লজিক:
//   - orders   : যে কেউ নতুন অর্ডার তৈরি করতে পারবে (checkout থেকে),
//                কিন্তু পড়া/এডিট/ডিলিট শুধু লগইন করা অ্যাডমিন করতে পারবে।
//   - siteContent : যে কেউ পড়তে পারবে (landing/checkout/thankyou পেজ
//                লোড করার জন্য দরকার), কিন্তু লেখা শুধু লগইন করা অ্যাডমিন
//                করতে পারবে।
//
// সতর্কতা: এখানে "লগইন করা মানেই অ্যাডমিন" ধরে নেওয়া হয়েছে, কারণ এই
// প্রজেক্টে পাবলিক সাইন-আপ ফর্ম নেই — একাউন্ট শুধু আপনি নিজে Firebase
// Console থেকে বানাবেন। বড় টিমের জন্য custom claims / Cloud Functions
// দিয়ে আরও কড়াকড়ি করা যায় (README এর শেষে নোট আছে)।
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(
                        ['name', 'phone', 'address', 'product', 'quantity', 'total', 'status']
                      )
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.phone is string
                    && request.resource.data.quantity is number
                    && request.resource.data.total is number;
      allow read, update, delete: if request.auth != null;
    }

    match /siteContent/{pageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // এই দুটো ছাড়া বাকি সবকিছুতে ডিফল্টভাবে কোনো এক্সেস নেই।
  }
}
